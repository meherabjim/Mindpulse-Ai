# MindPulse AI Backend environment example
# Copy to .env only for local use. Never commit the runtime .env file.
# Replace all CHANGE_ME values before starting a production environment.

# Runtime
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_CREDENTIALS=false
HOST=0.0.0.0
NODE_ENV=production
PORT=5000

# Database
DB_HOST=db.example.internal
DB_NAME=mindpulse
DB_PORT=3306
DB_USER=mindpulse_app

# Sensitive
ADMIN_JWT_ACCESS_SECRET=CHANGE_ME_WITH_SECURE_VALUE
ADMIN_REFRESH_TOKEN_DAYS=CHANGE_ME_WITH_SECURE_VALUE
AI_SERVICE_API_KEY=CHANGE_ME_WITH_SECURE_VALUE
DB_PASSWORD=CHANGE_ME_WITH_SECURE_VALUE
JWT_ACCESS_SECRET=CHANGE_ME_WITH_SECURE_VALUE
REFRESH_TOKEN_DAYS=CHANGE_ME_WITH_SECURE_VALUE

# Service endpoint
AI_SERVICE_URL=https://service.example.com
CORS_ORIGIN=https://service.example.com

# Application configuration
ADMIN_BCRYPT_ROUNDS=CHANGE_ME
ADMIN_JWT_ACCESS_EXPIRES_IN=CHANGE_ME
ADMIN_JWT_AUDIENCE=CHANGE_ME
ADMIN_JWT_ISSUER=CHANGE_ME
AI_SERVICE_TIMEOUT_MS=CHANGE_ME
BCRYPT_ROUNDS=CHANGE_ME
FCM_ANDROID_CHANNEL_ID=CHANGE_ME
FCM_DRY_RUN=CHANGE_ME
FCM_MODE=CHANGE_ME
FIREBASE_PROJECT_ID=https://service.example.com
GOOGLE_APPLICATION_CREDENTIALS=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=CHANGE_ME
JWT_AUDIENCE=CHANGE_ME
JWT_ISSUER=CHANGE_ME
REPORT_FILE_EXPIRY_DAYS=CHANGE_ME
REPORT_STORAGE_DIR=CHANGE_ME

# Operational maintenance
RESET_ADMIN_EMAIL=CHANGE_ME
RESET_ADMIN_PASSWORD=CHANGE_ME_WITH_SECURE_VALUE
SUPER_ADMIN_EMAIL=CHANGE_ME
SUPER_ADMIN_NAME=CHANGE_ME
SUPER_ADMIN_PASSWORD=CHANGE_ME_WITH_SECURE_VALUE
