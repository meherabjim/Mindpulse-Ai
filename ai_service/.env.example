# MindPulse AI Service environment example
# Copy to .env only for local use. Never commit the runtime .env file.
# Replace all CHANGE_ME values before starting a production environment.

# Runtime
HOST=0.0.0.0
PORT=5000

# Database
DB_HOST=db.example.internal
DB_NAME=mindpulse
DB_PORT=3306
DB_USER=mindpulse_app

# Sensitive
DB_PASSWORD=CHANGE_ME_WITH_SECURE_VALUE
INTERNAL_API_KEY=CHANGE_ME_WITH_SECURE_VALUE

# Service endpoint
ALLOWED_ORIGINS=https://service.example.com

# Application configuration
APP_NAME=CHANGE_ME
ENVIRONMENT=CHANGE_ME
